  "cards": [
    {
      "dot": "cyan", "title": "Redirect hot path",
      "items": [
        "Redis first, MongoDB on a miss, then cached for 24h",
        "Cache fails open with a 250ms timeout, so Redis outages fall back to MongoDB",
        "The click is enqueued without awaiting; the worker writes analytics"
      ]
    },
    {
      "dot": "violet", "title": "Two Redis connections",
      "items": [
        "BullMQ: retries forever (maxRetriesPerRequest: null), one duplicate per worker",
        "Cache: no offline queue, 0 retries, so it never stalls a redirect"
      ]
    },
    {
      "dot": "amber", "title": "Local docker-compose",
      "items": [
        "nginx serves the built SPA and proxies /api and /health to the api container",
        "mongo:7 and redis:7-alpine replace Atlas and Upstash",
        "api and worker run as separate containers from the same image"
      ]
    }
