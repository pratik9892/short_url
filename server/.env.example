PORT=3000
NODE_ENV=development
# Render (free web service): set Start Command to `npm run start:with-worker` (API + BullMQ worker in one instance).
# Production: your Vercel URL (https://your-app.vercel.app). Comma-separate for multiple.
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/short_url
ACCESS_TOKEN_SECRET=change-me-access
ACCESS_TOKEN_EXPIRY=5h
REFRESH_TOKEN_SECRET=change-me-refresh
REFRESH_TOKEN_EXPIRY=5d
# Local Docker Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Upstash on Render — option A (one variable):
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-db.upstash.io:6379
#
# Option B (separate fields from Upstash dashboard):
# REDIS_HOST=your-db.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_password
# REDIS_TLS=true
# Email (Resend). Without RESEND_FROM_EMAIL the sender is onboarding@resend.dev,
# which only delivers to your own Resend account email. Use an address on a
# domain verified in Resend to email real users, e.g. Shortly <hello@yourdomain.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GOOGLE_CLIENT_ID=

# AI (Groq — OpenAI-compatible). Required for all AI features (no offline fallback).
# GROQ_API_KEY=
# Base only — do NOT add /chat/completions (the app appends that path).
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-20b

# Logging (pino). Default: debug in development, info in production, silent in tests.
# Levels: fatal, error, warn, info, debug, trace, silent
# LOG_LEVEL=info
