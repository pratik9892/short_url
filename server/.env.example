PORT=3000
NODE_ENV=development
# Production: your Vercel URL (https://your-app.vercel.app). Comma-separate for multiple.
CLIENT_ORIGIN=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/short_url
ACCESS_TOKEN_SECRET=change-me-access
ACCESS_TOKEN_EXPIRY=5h
REFRESH_TOKEN_SECRET=change-me-refresh
REFRESH_TOKEN_EXPIRY=5d
# Local Docker Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Upstash (production): paste from dashboard → Redis tab → copy TCP URL
# Use rediss:// if TLS is on (Upstash). Do not commit real passwords.
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-name.upstash.io:6379
SENDGRID_API_KEY=
SENDER_EMAIL=
GOOGLE_CLIENT_ID=

# AI (Groq — OpenAI-compatible). See https://console.groq.com/docs/models
# GROQ_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=allam-2-7b
